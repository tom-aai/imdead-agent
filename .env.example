# LiveKit Cloud project (room broker/SFU). The worker runs locally via `lk agent dev`
# and joins this cloud project so LemonSlice can join the same room.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AssemblyAI — required by the TTS plugin for the guest's cloned voice
# (custom cloned voices are only available through the plugin, not LiveKit Inference).
ASSEMBLYAI_API_KEY=

# LemonSlice — avatar driven by the ghost image.
LEMONSLICE_API_KEY=

# Local backend that serves the ghost image at GET /ghost-image/<session_id>.
BACKEND_URL=http://localhost:5001
